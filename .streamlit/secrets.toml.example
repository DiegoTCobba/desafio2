# Copia este archivo como .streamlit/secrets.toml (está en .gitignore: nunca lo subas a GitHub).

[auth]
# Opción recomendada: guarda solo el hash SHA-256 de la contraseña.
# Para generarlo:
#   python -c "import hashlib; print(hashlib.sha256('mi-clave-segura'.encode()).hexdigest())"
password_sha256 = "pega-aqui-el-hash"

# Alternativa simple para desarrollo local (no la uses en producción):
# password = "mi-clave-segura"

# Minutos sin actividad antes de cerrar la sesión automáticamente.
minutos_sesion = 60

[n8n]
# URL del webhook del workflow (POST /communitylab/actividades). Si la defines aquí,
# la app arranca conectada a n8n.
webhook_url = "https://tu-n8n/webhook/communitylab/actividades"

# Opcional: si el webhook usa "Header Auth" en n8n, pon aquí el nombre y el valor de la cabecera.
# header_name = "X-CommunityLab-Token"
# header_value = "un-token-largo-y-secreto"
